PORT=3001
DATABASE_PATH=./tradivia.db
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_WORKER_PATH=../../workers/documents
UPLOAD_DIR=./uploads
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
SEED_DEMO_DATA=false
VITE_API_URL=http://localhost:3001/api

# ── Assistant IA (chatbox dans l'interface) ──────────────────────────────────
# Fournisseur compatible OpenAI. Exemples :
#   Groq (gratuit): AGENT_BASE_URL=https://api.groq.com/openai/v1 AGENT_MODEL=openai/gpt-oss-20b
#   OpenAI        : AGENT_BASE_URL=https://api.openai.com/v1   AGENT_MODEL=gpt-4o-mini
#   OpenRouter    : AGENT_BASE_URL=https://openrouter.ai/api/v1 AGENT_MODEL=openai/gpt-4o-mini
#   DeepSeek      : AGENT_BASE_URL=https://api.deepseek.com     AGENT_MODEL=deepseek-flash
#   Ollama local  : AGENT_BASE_URL=http://localhost:11434/v1    AGENT_MODEL=qwen2.5:7b
AGENT_ENABLED=true
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=8
# true = envoie seulement les outils pertinents (recommande pour les petits modeles / limites TPM)
AGENT_COMPACT_TOOLS=true
# Limite de jetons en sortie (1024 conseille en gratuit Groq)
AGENT_MAX_TOKENS=1024
# false = les actions d'ecriture exigent une confirmation explicite (recommande)
AGENT_ALLOW_UNCONFIRMED_WRITES=false
# Optionnel : recherche web via Tavily (sinon DuckDuckGo HTML est utilise)
TAVILY_API_KEY=
# Navigation web JavaScript via Chrome/Edge deja installe (detection automatique).
# Forcer un navigateur : CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
